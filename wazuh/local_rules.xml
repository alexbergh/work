      <id>T1557</id>
    </mitre>
    <group>cisco,network,spoofing,network_device,</group>
  </rule>

  <!-- ==================== CONFIGURATION CHANGES (MITRE T1562) ==================== -->

  <!-- Linux: Configuration file change -->
  <!-- CIS: 6.1.1, NIST: CM-6, MITRE: T1562.001 -->
  <rule id="100109" level="9">
    <if_sid>550,553</if_sid>
    <match>/etc/</match>
    <description>Defense evasion: System configuration file modified in /etc/</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>linux,filesystem,configuration_change,defense_evasion,</group>
  </rule>

  <!-- ==================== SSH SECURITY (CIS 5.2.x) ==================== -->

  <!-- SSH: Failed login -->
  <!-- CIS: 5.2.4, NIST: AC-7, MITRE: T1110.001 -->
  <rule id="100110" level="8">
    <if_sid>5710</if_sid>
    <match>Failed password for</match>
    <description>SSH: Failed password authentication attempt</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>ssh,authentication_failed,</group>
  </rule>

  <!-- SSH: Successful login -->
  <!-- CIS: 5.2.1, NIST: AU-3, MITRE: T1078.003 -->
  <rule id="100111" level="5">
    <if_sid>5715</if_sid>
    <match>Accepted password for</match>
    <description>SSH: Successful password authentication (consider key-based auth)</description>
    <mitre>
      <id>T1078.003</id>
    </mitre>
    <group>ssh,authentication_success,</group>
  </rule>

  <!-- SSH: Brute force detection -->
  <!-- CIS: 5.2.5, NIST: AC-7, MITRE: T1110.001 -->
  <rule id="100112" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100110</if_matched_sid>
    <description>SSH brute force attack: 5+ failed attempts in 2 minutes</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>ssh,authentication_failed,brute_force,attack,</group>
  </rule>

  <!-- SSH: Root login attempt -->
  <!-- CIS: 5.2.2, NIST: AC-6, MITRE: T1078.003 -->
  <rule id="100116" level="10">
    <if_sid>5715,5716</if_sid>
    <user>root</user>
    <description>SSH: Direct root login detected (violates CIS 5.2.2 - PermitRootLogin should be no)</description>
    <mitre>
      <id>T1078.003</id>
    </mitre>
    <group>ssh,root_login,policy_violation,</group>
  </rule>

  <!-- SSH: Login with password (should use keys) -->
  <!-- CIS: 5.2.21, NIST: IA-5, MITRE: T1078 -->
  <rule id="100117" level="6">
    <if_sid>5715</if_sid>
    <match>Accepted password</match>
    <description>SSH: Password authentication used (CIS 5.2.21 recommends PasswordAuthentication no)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>ssh,authentication_success,policy_violation,</group>
  </rule>

  <!-- SSH: Key-based authentication -->
  <!-- CIS: 5.2.8, NIST: IA-5 -->
  <rule id="100118" level="3">
    <if_sid>5715</if_sid>
    <match>Accepted publickey</match>
    <description>SSH: Successful key-based authentication (compliant with CIS 5.2.8)</description>
    <group>ssh,authentication_success,compliant,</group>
  </rule>

  <!-- ==================== PRIVILEGE ESCALATION (MITRE T1548) ==================== -->

  <!-- Sudo: Privilege escalation attempt -->
  <!-- CIS: 5.2.7, NIST: AC-6, MITRE: T1548.003 -->
  <rule id="100113" level="12">
    <if_sid>5401</if_sid>
    <match>user NOT in sudoers</match>
    <description>Privilege escalation: Unauthorized sudo attempt - user not in sudoers</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>sudo,privilege_escalation,attack,</group>
  </rule>

  <!-- Root login detected -->
  <!-- CIS: 5.2.2, NIST: AC-6, MITRE: T1078.003 -->
  <rule id="100114" level="9">
    <if_sid>5501</if_sid>
    <user>root</user>
    <description>Direct root login detected (violates least privilege principle)</description>
    <mitre>
      <id>T1078.003</id>
    </mitre>
    <group>authentication_success,root_login,policy_violation,</group>
  </rule>

  <!-- Su command to root -->
  <!-- NIST: AC-6, MITRE: T1548.003 -->
  <rule id="100115" level="7">
    <if_sid>5303</if_sid>
    <match>to root</match>
    <description>Privilege escalation: User switched to root via su command</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>su,privilege_escalation,</group>
  </rule>

  <!-- ==================== WEB APPLICATION ATTACKS (MITRE T1190) ==================== -->

  <!-- SQL Injection attempt -->
  <!-- NIST: SI-10, MITRE: T1190 -->
  <rule id="100120" level="10">
    <if_sid>31100,31101</if_sid>
    <match>select|union|insert|update|delete|drop|exec|execute</match>
    <regex>(\%27)|(\')|(\-\-)|(\%23)|(#)</regex>
    <description>Web attack: SQL injection attempt detected</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,attack,sql_injection,initial_access,</group>
  </rule>

  <!-- XSS attempt -->
  <!-- NIST: SI-10, MITRE: T1189 -->
  <rule id="100121" level="10">
    <if_sid>31100,31101</if_sid>
    <regex>\<script|\%3Cscript|javascript:|onerror=|onload=</regex>
    <description>Web attack: Cross-Site Scripting (XSS) attempt detected</description>
    <mitre>
      <id>T1189</id>
    </mitre>
    <group>web,attack,xss,</group>
  </rule>

  <!-- Path traversal attempt -->
  <!-- NIST: SI-10, MITRE: T1083 -->
  <rule id="100122" level="10">
    <if_sid>31100,31101</if_sid>
    <regex>\.\.\/|\.\.\\|%2e%2e%2f|%2e%2e\/</regex>
    <description>Web attack: Path traversal attempt (directory escape)</description>
    <mitre>
      <id>T1083</id>
    </mitre>
    <group>web,attack,path_traversal,discovery,</group>
  </rule>

  <!-- Command injection attempt -->
  <!-- NIST: SI-10, MITRE: T1059 -->
  <rule id="100123" level="12">
    <if_sid>31100,31101</if_sid>
    <regex>\;|\||\`|\$\(|%0a|%0d</regex>
    <match>cat |ls |pwd|whoami|id |wget |curl </match>
    <description>Web attack: Command injection attempt detected</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>web,attack,command_injection,execution,</group>
  </rule>

