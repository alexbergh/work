<!--
  Custom Wazuh Detection Rules
  Adapted from SCA best practices (CIS Benchmarks, NIST 800-53, MITRE ATT&CK)
  
  ID Range: 100000-199999 (custom rules, no conflicts with default policies)
  
  Level Guidelines:
    0-3:  Informational
    4-7:  Low-Medium severity
    8-10: High severity
    11-15: Critical severity
-->

<group name="local_rules,">

  <!-- ==================== AUTHENTICATION - BRUTE FORCE (MITRE T1110) ==================== -->

  <!-- Windows: Multiple failed login attempts (brute force detection) -->
  <!-- CIS: 5.2.5, NIST: AC-7, MITRE: T1110.001 -->
  <rule id="100100" level="10" frequency="5" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <description>Windows brute force attack: Multiple failed login attempts detected (5+ in 2 min)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,windows,brute_force,attack,</group>
  </rule>

  <!-- Single Windows failed login -->
  <!-- CIS: 5.2.4, NIST: AC-7, MITRE: T1078 -->
  <rule id="100101" level="5">
    <if_sid>60122</if_sid>
    <field name="win.system.eventID">^4625$</field>
    <description>Windows failed login attempt (EventID 4625)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_failed,windows,</group>
  </rule>

  <!-- ==================== LINUX AUTHENTICATION ==================== -->

  <!-- Sudo command executed -->
  <!-- CIS: 5.2.1, NIST: AC-6, MITRE: T1548.003 -->
  <rule id="100102" level="5">
    <if_sid>5402,5403</if_sid>
    <description>Sudo command executed successfully - privilege elevation</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>sudo,executed_command,privilege_escalation,</group>
  </rule>

  <!-- ==================== NETWORK RECONNAISSANCE (MITRE T1046) ==================== -->

  <!-- Port scan detection -->
  <!-- NIST: SI-4, MITRE: T1046 -->
  <rule id="100103" level="7" frequency="10" timeframe="60">
    <if_matched_sid>100104</if_matched_sid>
    <description>Network reconnaissance: Port scan detected (10+ connection attempts in 60s)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>network,scan,portscan,reconnaissance,</group>
  </rule>

  <rule id="100104" level="3">
    <if_sid>5710</if_sid>
    <description>Connection attempt to closed port</description>
    <group>network,connection_attempt,</group>
  </rule>

  <!-- ==================== CREDENTIAL ACCESS (MITRE T1003) ==================== -->

  <!-- Restricted file access -->
  <!-- CIS: 6.1.3, NIST: AC-3, MITRE: T1003.008 -->
  <rule id="100105" level="8">
    <if_sid>80700</if_sid>
    <match>/etc/shadow|/etc/passwd|/etc/sudoers</match>
    <description>Credential access: Sensitive authentication file accessed</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
    <group>audit,filesystem,restricted_access,credential_access,</group>
  </rule>

  <!-- ==================== CISCO NETWORK DEVICES ==================== -->

  <!-- Cisco: Failed login -->
  <!-- NIST: AC-7, MITRE: T1110 -->
  <rule id="100106" level="8">
    <if_sid>4715</if_sid>
    <match>%SEC_LOGIN-4-LOGIN_FAILED</match>
    <description>Cisco device: Failed login attempt</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>cisco,authentication_failed,network_device,</group>
  </rule>

  <!-- Cisco: Successful login -->
  <!-- NIST: AU-3, MITRE: T1078 -->
  <rule id="100107" level="5">
    <if_sid>4715</if_sid>
    <match>%SEC_LOGIN-5-LOGIN_SUCCESS</match>
    <description>Cisco device: Successful login</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>cisco,authentication_success,network_device,</group>
  </rule>

  <!-- Cisco: IP access log (possible spoofing) -->
  <!-- NIST: SC-7, MITRE: T1557 -->
  <rule id="100108" level="10">
    <if_sid>4715</if_sid>
    <match>%SEC-6-IPACCESSLOGP</match>
